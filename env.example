# BookOasis 3D 서재 설정 - 이 파일을 .env로 복사해서 쓴다 (cp env.example .env)
# 자세한 설명은 docs/guide.md

# ── 웹 화면 ──
# 로그인은 세션 쿠키. 계정은 DATA_DIR/users.json (화면 왼쪽 아래 설정 > 사용자에서 추가·삭제·비밀번호 변경)
# 관리자: 모든 설정 / 관람자: 둘러보기·읽기·함께 보기만 (성인 층은 허용한 관람자만)
WEB_HOST=127.0.0.1
WEB_PORT=5932
# 첫 관리자 계정: 사용자가 하나도 없을 때 한 번만 이 값으로 만든다 (그 뒤 비밀번호는 화면에서 바꾸고, 여기 값은 지워도 됨)
# 둘 다 비우면 첫 접속 화면에서 '관리자 계정 만들기'. 단 0.0.0.0 등 외부 주소로 열 때는 계정이 없으면 시작하지 않는다
WEB_USER=admin
WEB_PASSWORD=
# 계정이 없어도 외부 주소로 시작 허용 (처음 연 사람이 관리자를 만들 수 있으니 안전한 망에서만)
WEB_ALLOW_NO_AUTH=false

# ── 데이터 ──
# 서재 설정·AI 직원·표지 캐시·계정 등. 상대 경로는 이 폴더 기준
DATA_DIR=data
LOG_LEVEL=INFO
# 새 버전 확인 주소 (비우면 확인하지 않음)
# UPDATE_CHECK_URL=

# ── BookOasis (필수) ──
# 표지(/covers/…)와 작품 상세를 받을 BookOasis 주소 (이 서버에서 접속할 수 있는 주소)
BOOKOASIS_URL=http://127.0.0.1:5930
# BookOasis DB: {db_type}은 아래 BOOKOASIS_DB_TYPES의 각 값으로 바뀐다. MariaDB/MySQL은 mysql://, SQLite는 sqlite:////절대/경로
#    비밀번호에 특수문자가 있으면 URL 인코딩 (@ → %40, : → %3A, / → %2F)
#    예) BOOKOASIS_DB_URL=mysql://bookoasis:비밀번호@192.168.0.10:3306/bookoasis_{db_type}
BOOKOASIS_DB_URL=
# 층으로 만들 세션 (general=1층 일반, adult, audiobook, video 순서로 층이 된다)
BOOKOASIS_DB_TYPES=general,adult,audiobook,video
# 세션마다 DB가 다르게 생겼으면 따로 지정 (지정한 값이 BOOKOASIS_DB_URL보다 우선)
# BOOKOASIS_DB_URL_GENERAL=
# BOOKOASIS_DB_URL_ADULT=
# BOOKOASIS_DB_URL_AUDIOBOOK=
# BOOKOASIS_DB_URL_VIDEO=

# ── 서재 ──
# 보관함마다 최근 추가된 작품 몇 개를 책장에 놓을지 (10~1500, 많으면 무거움)
LIB3D_PER_LIBRARY=300
# 1층 입구 오른쪽 브런치 연재 낭독 코너 (요일별 연재 → 골라 듣기). Edge 음성은 pip install edge-tts (선택)
LIB3D_BRUNCH=true
# 브라우저에서 여는 BookOasis 주소 (작품 상세·BookOasis 뷰어 링크). BOOKOASIS_URL이 서버 안에서만 통하는 주소일 때 (예: http://192.168.0.10:5930)
LIB3D_PUBLIC_URL=
# 열기 주소를 다른 형식으로 ({id}=도서 번호, {library_id}, {db_type}, {series}, {bookoasis}=BOOKOASIS_URL)
LIB3D_BOOK_URL=
# BookOasis에 표지가 없을 때 쓸 표지 주소 형식 (그다음 폴더의 cover/folder/poster → 첫 zip의 첫 그림)
LIB3D_COVER_URL=

# ── 오락실 (1층 입구 왼쪽 미니게임) ──
MINI_ENABLED=true
# 그림 땅따먹기 표지 그림 폴더 (jpg/png/gif/webp). 비우면 mini/games/picture-territory/covers
MINI_COVERS_DIR=

# ── 영화관 층 (YMPlayer, 선택) ──
# 브라우저에서 열리는 YMPlayer 주소 (예 http://192.168.0.10:8899, 비우면 영화관 층 없음)
LIB3D_YMPLAYER_URL=
# 영화관에서 YMPlayer를 여는 방법: auto(브라우저가 막을 조건이면 새 탭) / tab(늘 새 탭) / frame(늘 서재 안)
LIB3D_YMPLAYER_EMBED=auto
# 영화관 스크린에 IPTV·텔레그램을 직접 상영 (서재 서버가 YMPlayer에 로그인해 중계). 서재용 YMPlayer 계정 권장
LIB3D_YMPLAYER_INTERNAL=
LIB3D_YMPLAYER_USER=
LIB3D_YMPLAYER_PASSWORD=
LIB3D_YMPLAYER_VIEWERS=true

# ── AI ([설정 > AI 설정] 화면에서 바꾸면 이 파일에 저장됨, 유료 API면 호출마다 요금이 든다) ──
# 연결 방식: openai = OpenAI 호환 /chat/completions (LiteLLM·Ollama·LM Studio·OpenAI 등, 추가 패키지 없음)
#            anthropic = Claude API (pip install anthropic 필요)
LIB3D_AI_PROVIDER=openai
# OpenAI 호환 API 주소 (예: http://192.168.0.10:4000/v1 - 뒤에 /chat/completions를 붙여 부른다)
LIB3D_AI_BASE_URL=
# API 키 (anthropic에서 비우면 ANTHROPIC_API_KEY 등 SDK 기본 인증)
LIB3D_AI_API_KEY=
# 모델 이름 (openai는 게이트웨이에 등록된 이름 그대로, anthropic은 비우면 claude-opus-5-5)
LIB3D_AI_MODEL=
# 손님 대화: 층마다 두 손님이 무작위 책 한 권을 두고 이야기 (말풍선). 간격(초)보다 자주 부르지 않고 가까이 있을 때만 부른다
LIB3D_AI_CHAT=false
LIB3D_AI_CHAT_SEC=60
# AI 직원 응대: 채팅창의 @사서·@도슨트에 BookOasis MCP(읽기 전용 도구)로 서재 데이터를 찾아 답함 (직원·자율 업무는 [AI 직원])
LIB3D_AI_ASK=false
# 하루 LLM 호출 한도 (손님 대화·직원 응대·자율 업무 합계, 0 = 없음)
LIB3D_AI_DAILY=1000
# BookOasis MCP 실행 명령 (도커: docker exec -i bookoasis python3 tools/mcp_server.py / 직접 설치: python3 /경로/tools/mcp_server.py)
LIB3D_MCP_COMMAND=
# 추가 MCP: 한 줄에 '이름 = 실행 명령' 또는 '이름 = https://주소' (여러 줄은 \n으로, 화면에서 넣는 것을 권장). 도구 이름은 '이름__도구'
LIB3D_MCP_SERVERS=
# 기본 도구(지금 시각·날씨 Open-Meteo·웹 페이지 읽기)
LIB3D_AI_BUILTIN=true

# ── 배달·바깥 프로그램 ──
# POST /api/lib3d/events 토큰 (비우면 꺼짐, 긴 무작위 문자열). 디스코드 봇·BookOasis Assistant(웹툰 배달)에 같은 값을 넣는다
LIB3D_EVENT_TOKEN=

# 바깥 AI(전화): AI 직원 한 명의 생각을 다른 프로그램에 맡기는 예전 방식. 디스코드는 아래 채널 연동을 쓰므로 기본은 끔 (1이면 [AI 직원] 카드에 주소 칸이 보임)
LIB3D_REMOTE_AI=0

# ── 디스코드 채널 연동 (비우면 꺼짐) ──
# 보내기: 디스코드 채널 [설정 > 연동 > 웹후크]에서 만든 주소. 3D 서재 채팅·AI 직원의 말·배달 도착을 "이름 (3D 서재)"로 보낸다
LIB3D_DISCORD_WEBHOOK_URL=
# 스레드(포럼 글)로 보낼 때만: 스레드 ID (웹후크 주소 뒤에 ?thread_id=... 로 붙여도 된다). 받기도 그 스레드를 읽는다
LIB3D_DISCORD_THREAD_ID=
# 받기: 디스코드 봇 토큰 (개발자 페이지에서 봇을 만들고 Message Content Intent를 켠 뒤, 그 채널을 볼 수 있게 서버에 초대)
#   그 채널의 새 메시지가 1층 채팅에 바로 보이고, 말한 사람이 "[이름표] 이름" 손님으로 1층 라운지에 들어온다
LIB3D_DISCORD_BOT_TOKEN=
# 읽을 채널 ID (비우면 웹후크가 걸린 채널, 스레드로 보내면 그 스레드)
LIB3D_DISCORD_CHANNEL_ID=
# 디스코드에서 온 사람 이름 앞에 붙는 이름표 (예: 출판사 → [출판사] 애순이)
LIB3D_DISCORD_LABEL=디스코드
# 보낼 것 (쉼표로): chat=함께 보기 채팅, staff=AI 직원·손님이 한 말, delivery=배달 도착 (귓속말·성인 층은 늘 빼고 보냄)
LIB3D_DISCORD_SEND=chat,staff
# 디스코드를 읽는 간격(초, 2 이상)
LIB3D_DISCORD_POLL_SEC=3
